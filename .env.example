# The web app's configuration. Copy this file to .env.local; Next.js reads it
# in development and never commits it. Only names that start with NEXT_PUBLIC_
# reach the browser — none of these do.

# The API's origin, as the web app's server reaches it for server renders
# (src/server/api). The browser never uses it: it calls /api/v1 on its own
# origin, where the local HTTPS proxy routes it to the API (umbrella 0.2.1).
API_INTERNAL_URL=http://localhost:3000
